<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@800;900&family=IBM+Plex+Mono:wght@400;500;600&display=block" rel="stylesheet">
<style>
  .view:has(> .fp) { position: relative; padding: 0; overflow: hidden; }
  /* mashups des écrans gris et couleur : le framework y met les vues à z-index -2, ce qui une fois
     la vue positionnée la ferait passer sous le fond de l'écran (rendu tout blanc) */
  .trmnl .screen .mashup .view:has(> .fp) { z-index: 0; }
  .fp { position: absolute; inset: 0; overflow: hidden; container-type: size;
        --bg: #f2eee6; --ink: #111111; --muted: #444455; --sky: #ccddee; --top: #444455;
        --sun: #ffcc44; --sun-stroke: none; --cloud: #ffffff; --cloud-stroke: none; --star: #eeeedd; --accent: #dd2233;
        --tail: #ffffff; --s1: #8a8f99; --s2: #c9ccd2; --body: #8a8f99;
        --sky-h: 67.5%; --pad: 4.4cqw; --f-top: max(11px, 1.35cqw); --f-meta: max(12px, 1.45cqw);
        --f-route: 6.6cqw; --f-sub: max(12px, 1.5cqw); --compass: min(9cqw, 15cqh);
        background: var(--bg); color: var(--ink); font-family: 'IBM Plex Mono', ui-monospace, monospace; }
  .fp { --rain: #5577aa; --snow: #ffffff; --snow-stroke: none; --fog: #ffffff; --glow: #ffcc88; --bolt: #ffcc44; }
  .fp--grey { --sky: #aabbcc; --cloud: #e6e9ee; }
  .fp--wx-storm { --sky: #8899aa; --cloud: #667788; }
  .fp--dusk { --sky: #ee9977; --sun: #ee5533; --top: #442233; }
  .fp--dusk.fp--grey { --sky: #887799; --cloud: #aa99aa; --glow: #aa8899; --top: #eeeedd; --rain: #eeeedd; }
  .fp--night { --sky: #223344; --top: #ccddee; --sun: #eeeedd; --cloud: #445566; --rain: #8899bb; }
  .fp--night.fp--grey { --sky: #2a3038; --cloud: #3d4550; }

  .fp.fp--eink { --bg: #ffffff; --ink: #000000; --muted: #000000; --sky: #ffffff; --top: #000000; --sun: url(#fp-hatch);
              --sun-stroke: #000000; --cloud: #ffffff; --cloud-stroke: #000000; --accent: #000000;
              --tail: #ffffff; --s1: #000000; --s2: #000000; --body: #000000;
              --rain: #000000; --snow: #ffffff; --snow-stroke: #000000; --fog: #000000; --bolt: #000000; --glow: url(#fp-lines); }
  .fp.fp--eink.fp--grey, .fp.fp--eink.fp--dusk { --sky: #ffffff; --top: #000000; --cloud: #ffffff; --sun: url(#fp-hatch); --rain: #000000; }
  .fp.fp--eink.fp--wx-storm { --sky: #ffffff; --cloud: #000000; }
  .fp.fp--eink.fp--night { --sky: #000000; --top: #ffffff; --sun: #ffffff; --sun-stroke: none; --cloud: #000000;
                        --cloud-stroke: #ffffff; --star: #ffffff; --rain: #ffffff; --snow: #ffffff; --snow-stroke: #ffffff;
                        --fog: #ffffff; --bolt: #ffffff; }

  /* calques du ciel selon la lumière et la météo */
  .fp-sky .wx { display: none; }
  .fp--day .fp-sun, .fp--dusk .fp-sun, .fp--night .fp-moon, .fp--night .fp-stars,
  .fp--dusk .fp-glow, .fp--eink.fp--wx-overcast:not(.fp--night) .fp-dots,
  .fp--wx-cloudy .fp-clouds-more, .fp--grey .fp-clouds-more,
  .fp--wx-rain .fp-rain, .fp--wx-storm .fp-rain, .fp--wx-snow .fp-snow, .fp--wx-fog .fp-fog,
  .fp--wx-storm .fp-bolt { display: inline; }
  .fp--grey .fp-sun, .fp--grey .fp-moon, .fp--grey .fp-stars { display: none; }

  .fp-sky { position: absolute; left: 0; right: 0; top: 0; height: var(--sky-h); background: var(--sky); overflow: hidden; }
  .fp-sky > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fp-art { position: absolute; left: 8%; right: 8%; top: 16%; bottom: 6%; }
  .fp-art svg { width: 100%; height: 100%; }
  .fp-top { position: absolute; top: calc(var(--pad) * .6); left: var(--pad); right: var(--pad); display: flex;
            justify-content: space-between; gap: 2em; font-size: var(--f-top); letter-spacing: .28em;
            text-transform: uppercase; color: var(--top); white-space: nowrap; }
  .fp-top > span:first-child { overflow: hidden; text-overflow: ellipsis; }
  .fp-upd-short { display: none; }
  .fp--half_horizontal .fp-upd-long, .fp--half_vertical .fp-upd-long, .fp--quadrant .fp-upd-long { display: none; }
  .fp--half_horizontal .fp-upd-short, .fp--half_vertical .fp-upd-short, .fp--quadrant .fp-upd-short { display: inline; }

  .fp-info { position: absolute; left: var(--pad); right: var(--pad); top: var(--sky-h); bottom: 0;
             border-top: max(2px, .25cqw) solid var(--ink); display: flex; align-items: center; gap: 3cqw; }
  .fp-text { flex: 1 1 auto; min-width: 0; }
  .fp-meta { font-size: var(--f-meta); letter-spacing: .2em; text-transform: uppercase; color: var(--muted);
             white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .fp-route { font-family: 'Archivo', 'Arial Black', sans-serif; font-weight: 900; font-size: var(--f-route);
              line-height: 1.05; text-transform: uppercase; margin: 0 0 .16em; white-space: nowrap; overflow: hidden; }
  .fp-route .arrow { font-weight: 400; margin: 0 .15em; }
  .fp-meta { margin-bottom: .55em; }
  .fp-sub { font-size: var(--f-sub); color: var(--muted); letter-spacing: .03em; }
  .fp-sub b { color: var(--ink); font-weight: 500; }
  .fp-compass { flex: 0 0 auto; text-align: center; font-size: var(--f-top); letter-spacing: .2em; color: var(--muted); }
  .fp-compass svg { display: block; width: var(--compass); height: var(--compass); margin: .4em auto; }
  .fp-tag { display: inline-block; text-transform: uppercase; border: 2px solid var(--ink); border-radius: .4em; padding: .4em .9em; color: var(--ink);
            font-size: var(--f-top); letter-spacing: .2em; }
  .fp-err .fp-meta { color: var(--accent); }
  .fp [data-show] { display: none; }
  .fp--plane [data-show~="plane"], .fp--empty [data-show~="empty"], .fp--error [data-show~="error"] { display: revert; }
  .fp--plane .fp-compass[data-show~="plane"], .fp--empty .fp-compass[data-show~="empty"] { display: block; }
  /* e-ink 1 bit : pas d'anticrénelage, il faut des traits plus épais */
  .fp--eink { font-weight: 600; --f-top: max(13px, 1.35cqw); --f-meta: max(13px, 1.45cqw); --f-sub: max(13px, 1.5cqw); }
  .fp--eink .fp-sub b { font-weight: 600; }
  .fp--eink .fp-top, .fp--eink .fp-meta { letter-spacing: .14em; }

  .fp--half_horizontal { --pad: 3cqw; --f-route: 5cqw; --compass: 30cqh; }
  .fp--half_horizontal .fp-sky { right: auto; width: 34%; height: 100%; border-right: max(2px, .25cqw) solid var(--ink); }
  .fp--half_horizontal .fp-art { left: 4%; right: 4%; top: 20%; bottom: 6%; }
  .fp--half_horizontal .fp-info { left: calc(34% + var(--pad)); top: 0; border-top: 0; }
  .fp--half_horizontal .fp-top > span:first-child, .fp--half_vertical .fp-top > span:first-child { display: none; }
  .fp--half_horizontal .fp-top, .fp--half_vertical .fp-top { justify-content: flex-end; }
  .fp--half_horizontal .fp-sub { line-height: 1.5; }
  .fp--half_vertical { --sky-h: 42%; --pad: 5cqw; --f-top: max(11px, 2.6cqw); --f-meta: max(11px, 2.9cqw);
                       --f-route: 11cqw; --f-sub: max(12px, 3.2cqw); }
  .fp--half_vertical .fp-art { left: 4%; right: 4%; top: 18%; }
  .fp--half_vertical .fp-meta { white-space: normal; line-height: 1.5; }
  .fp--half_vertical .fp-info { align-items: flex-start; padding-top: 6cqw; }
  .fp--half_vertical .fp-sub { line-height: 1.5; }
  .fp--half_vertical .fp-top, .fp--quadrant .fp-top { letter-spacing: .1em; }
  .fp--half_vertical .fp-compass, .fp--quadrant .fp-compass { display: none !important; }
  .fp--quadrant { --sky-h: 44%; --pad: 4.5cqw; --f-top: max(11px, 2.8cqw); --f-meta: max(11px, 2.8cqw);
                  --f-route: 9cqw; --f-sub: max(11px, 2.8cqw); }
  .fp--quadrant .fp-art { left: 4%; right: 4%; top: 24%; bottom: 4%; }
  .fp--quadrant .fp-top > span:first-child { display: none; }
  .fp--quadrant .fp-top { justify-content: flex-end; }
  .fp--quadrant .fp-sub { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>

{% template flightposter %}
<div class="fp fp--{{ size }}{% if cf.style == 'color' %} fp--color{% else %} fp--eink{% endif %}"
     data-lat="{{ cf.lat }}" data-lon="{{ cf.lon }}" data-radius="{{ cf.radius_km | default: 25 }}"
     data-prefer="{{ cf.prefer_airliners | default: 'yes' }}" data-lang="{{ cf.language | default: 'en' }}"
     data-units="{{ cf.units | default: 'metric' }}" data-ts="{{ ts }}" data-off="{{ off | default: 0 }}">
  <script type="application/json" class="fp-data">{{ aircraft | json }}</script>
  <script type="application/json" class="fp-wx-data">{{ weather | json }}</script>
  <div class="fp-sky">
    <svg viewBox="0 0 1280 540" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="fp-hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="9" height="9" fill="#fff"/><rect width="3" height="9" fill="#000"/>
        </pattern>
        <pattern id="fp-lines" width="12" height="15" patternUnits="userSpaceOnUse">
          <rect width="12" height="15" fill="#fff"/><rect width="12" height="2" fill="#000"/>
        </pattern>
        <pattern id="fp-dots" width="16" height="16" patternUnits="userSpaceOnUse">
          <circle cx="4" cy="4" r="1.6" fill="#000"/><circle cx="12" cy="12" r="1.6" fill="#000"/>
        </pattern>
        <pattern id="fp-fog-p" width="300" height="70" patternUnits="userSpaceOnUse">
          <path d="M10 14 H150 M170 50 H280" style="stroke:var(--fog)" stroke-width="4" stroke-linecap="round" stroke-dasharray="40 14"/>
        </pattern>
        <g id="fp-cloud"><path d="M30 64 a24 24 0 0 1 4-47 a34 34 0 0 1 62-6 a26 26 0 0 1 38 26 a16 16 0 0 1 2 27 Z"/></g>
      </defs>
      <rect class="wx fp-dots" x="0" y="0" width="1280" height="540" fill="url(#fp-dots)" opacity=".9"/>
      <rect class="wx fp-glow" x="0" y="330" width="1280" height="210" style="fill:var(--glow)"/>
      <g class="wx fp-stars" style="fill:var(--star)">
        <circle cx="140" cy="130" r="2"/><circle cx="310" cy="210" r="1.6"/><circle cx="420" cy="110" r="2.2"/>
        <circle cx="980" cy="150" r="1.8"/><circle cx="1130" cy="250" r="2"/><circle cx="860" cy="90" r="1.5"/>
        <circle cx="230" cy="350" r="1.5"/><circle cx="1060" cy="390" r="1.7"/><circle cx="560" cy="80" r="1.4"/>
      </g>
      <g class="wx fp-rain" style="stroke:var(--rain)" stroke-linecap="round"></g>
      <g class="wx fp-snow" style="fill:var(--snow);stroke:var(--snow-stroke)" stroke-width="2"></g>
      <g style="fill:var(--cloud);stroke:var(--cloud-stroke);stroke-width:3">
        <g class="wx fp-clouds-more">
          <use href="#fp-cloud" transform="translate(-30 105) scale(1.5)"/>
          <use href="#fp-cloud" transform="translate(330 90) scale(1.6)"/>
          <use href="#fp-cloud" transform="translate(700 100) scale(1.4)"/>
          <use href="#fp-cloud" transform="translate(1040 85) scale(1.5)"/>
          <use href="#fp-cloud" transform="translate(520 330) scale(1.3)"/>
        </g>
        <use href="#fp-cloud" transform="translate(150 250) scale(1.2)"/>
        <use href="#fp-cloud" transform="translate(930 190) scale(.9)"/>
        <use href="#fp-cloud" transform="translate(1010 400) scale(1.1)"/>
        <use href="#fp-cloud" transform="translate(80 420) scale(.7)"/>
      </g>
      <path class="wx fp-bolt" d="M372 150 L322 262 L356 262 L330 360 L424 228 L386 228 L414 150 Z"
            style="fill:var(--bolt);stroke:var(--cloud-stroke)" stroke-width="3" stroke-linejoin="round"/>
      <rect class="wx fp-fog" x="0" y="190" width="1280" height="350" fill="url(#fp-fog-p)"/>
    </svg>
    <div class="fp-art">
      <svg viewBox="0 -40 660 250" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
        <g class="fp-flip">
          <g class="wx fp-sun" style="fill:var(--sun);stroke:var(--sun-stroke);stroke-width:3">
            <circle class="fp-sun-disc" cx="383" cy="48" r="61"/>
          </g>
          <g class="wx fp-moon">
            <circle cx="383" cy="44" r="54" style="fill:var(--sun)"/>
            <circle cx="405" cy="29" r="49" style="fill:var(--sky)"/>
          </g>
          <g class="fp-plane" data-show="plane" stroke="#000" stroke-width="3" stroke-linejoin="round">
            <clipPath id="fp-fin"><path d="M496 94 L566 8 L606 8 L592 94 Z"/></clipPath>
            <path d="M496 94 L566 8 L606 8 L592 94 Z" style="fill:var(--tail)"/>
            <g clip-path="url(#fp-fin)" stroke="none">
              <path d="M520 94 L590 8 L604 8 L534 94 Z" style="fill:var(--s1)"/>
              <path d="M546 94 L616 8 L630 8 L560 94 Z" style="fill:var(--s2)"/>
              <path d="M572 94 L642 8 L656 8 L586 94 Z" style="fill:var(--s1)"/>
            </g>
            <path d="M496 94 L566 8 L606 8 L592 94 Z" fill="none"/>
            <path d="M28 124 C30 104 58 94 104 93 L540 92 L620 80 L612 112 C596 130 566 142 520 143 L100 143 C58 143 26 138 28 124 Z" fill="#fff"/>
            <path d="M48 112 L72 106 L76 113 L46 117 Z" fill="#000" stroke-width="1"/>
            <rect x="120" y="114" width="340" height="10" rx="5" stroke="none" style="fill:var(--body)"/>
            <rect x="120" y="127" width="340" height="4" rx="2" stroke="none" style="fill:var(--s2)"/>
            <path d="M548 112 L604 104 L618 114 L566 120 Z" fill="#fff"/>
            <path d="M270 132 L360 132 L440 180 L420 184 Z" fill="#fff"/>
            <rect x="258" y="146" width="78" height="32" rx="14" fill="#fff"/>
            <ellipse cx="262" cy="162" rx="8" ry="16" fill="#fff"/>
          </g>
        </g>
      </svg>
    </div>
    <div class="fp-top">
      <span><span class="fp-k"></span><span class="fp-city">{{ cf.city }}</span></span>
      <span class="fp-upd"><span class="fp-upd-long"></span><span class="fp-upd-short"></span><span class="fp-time">--:--</span></span>
    </div>
  </div>
  <div class="fp-info">
    <div class="fp-text">
      <div class="fp-route"></div>
      <div class="fp-meta"></div>
      <div class="fp-sub"></div>
    </div>
    <div class="fp-compass" data-show="plane">
      N
      <svg viewBox="0 0 120 120">
        <circle cx="60" cy="60" r="54" fill="none" style="stroke:var(--ink)" stroke-width="3"/>
        <g class="fp-needle"><path d="M60 18 L72 66 L60 58 L48 66 Z" style="fill:var(--accent)"/>
          <circle cx="60" cy="60" r="5" style="fill:var(--ink)"/></g>
      </svg>
      <span class="fp-reg"></span>
    </div>
    <div class="fp-compass" data-show="empty"><span class="fp-tag"></span></div>
  </div>
</div>
{% endtemplate %}

